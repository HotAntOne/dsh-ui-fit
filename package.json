{
  "name": "dsh-ui-fit",
  "version": "1.2.4",
  "description": "One plugin for five switchable UI refinements in the DSH Web GUI: foldable left navigation, a tidier composer row, phone-density compaction, conversation width tiers, and hiding the WorkBuddy credit readout on phones only.",
  "type": "module",
  "main": "index.js",
  "license": "Apache-2.0",
  "author": "dsh-ui-fit contributors",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HotAntOne/dsh-ui-fit.git"
  },
  "homepage": "https://github.com/HotAntOne/dsh-ui-fit#readme",
  "bugs": {
    "url": "https://github.com/HotAntOne/dsh-ui-fit/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ui",
    "sidebar",
    "composer",
    "mobile",
    "compact"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "test-client.mjs",
    "check-hooks.mjs",
    "lint-identifiers.mjs",
    "ensure-deps.mjs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js",
    "test": "node ensure-deps.mjs && node lint-identifiers.mjs && node test-client.mjs && node check-hooks.mjs",
    "check:hooks": "node check-hooks.mjs",
    "setup": "node ensure-deps.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
